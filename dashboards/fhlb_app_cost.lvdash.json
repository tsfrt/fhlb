{
  "datasets": [
    {
      "name": "cost",
      "displayName": "Scoped cost",
      "queryLines": [
        "WITH scoped AS (\n  SELECT\n    u.usage_date,\n    CASE\n      WHEN u.usage_metadata.app_name = 'fhlb-command-center' THEN 'App'\n      WHEN u.usage_metadata.endpoint_name = 'fhlb-member-credit-risk' THEN 'Model Serving (credit risk)'\n      WHEN u.usage_metadata.endpoint_name = 'fhlb-governed-llm' THEN 'AI Gateway (LLM)'\n      WHEN u.usage_metadata.dlt_pipeline_id = 'e69628a9-d647-4785-a93f-254f8512560d' THEN 'Lakeflow Pipeline'\n      WHEN u.usage_metadata.project_id = '71819b98-8936-4e36-9e5b-af9d6398dc18' THEN 'Lakebase'\n      WHEN u.usage_metadata.warehouse_id = '688f49c732cf9083' THEN 'SQL Warehouse'\n    END AS component,\n    u.billing_origin_product AS product,\n    u.sku_name,\n    u.usage_quantity AS dbus,\n    u.usage_quantity * CAST(lp.pricing.default AS DOUBLE) AS cost_usd\n  FROM system.billing.usage u\n  LEFT JOIN system.billing.list_prices lp\n    ON u.sku_name = lp.sku_name\n   AND u.usage_start_time >= lp.price_start_time\n   AND (lp.price_end_time IS NULL OR u.usage_start_time < lp.price_end_time)\n  WHERE u.workspace_id = '7474656503943141'\n    AND u.usage_date >= date_sub(current_date(), 90)\n    AND (\n      u.usage_metadata.app_name = 'fhlb-command-center'\n      OR u.usage_metadata.endpoint_name IN ('fhlb-governed-llm','fhlb-member-credit-risk')\n      OR u.usage_metadata.dlt_pipeline_id = 'e69628a9-d647-4785-a93f-254f8512560d'\n      OR u.usage_metadata.project_id = '71819b98-8936-4e36-9e5b-af9d6398dc18'\n      OR u.usage_metadata.warehouse_id = '688f49c732cf9083'\n    )\n)\nSELECT usage_date, component, product, sku_name,\n       SUM(cost_usd) AS cost_usd, SUM(dbus) AS dbus\nFROM scoped\nWHERE component IS NOT NULL\nGROUP BY usage_date, component, product, sku_name"
      ]
    }
  ],
